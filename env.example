# ============================================================================
# SERVER-SIDE ONLY
# ----------------------------------------------------------------------------
# None of these are prefixed with NEXT_PUBLIC_, so none reach the browser
# bundle. That is deliberate: the browser never needs to know where the backend
# lives, because it only ever talks to this app's own same-origin /api/* routes.
#
# Every value below has a working development default in src/config/env.ts, so
# `pnpm dev` runs with no .env at all.
# ============================================================================

# Origin + prefix of the Express backend. No trailing slash.
# The backend listens on :3000, which is why this app runs on :3001.
API_BASE_URL=http://localhost:3000/api/v1

# Public origin of THIS app.
# Must match the backend's FRONTEND_URL, otherwise the referral links produced
# by GET /referrals/link will point somewhere that does not resolve.
APP_URL=https://dollar2x.trade/

# Upstream request timeout in ms. Generous, because some backend routes make
# on-chain RPC calls which can be slow.
API_TIMEOUT_MS=20000

# ============================================================================
# WEB3 WALLET CONFIGURATION
# ----------------------------------------------------------------------------
# These are prefixed with NEXT_PUBLIC_ so they are available in the browser
# for Web3 wallet integration.
# ============================================================================

# Reown AppKit Project ID for wallet connection
NEXT_PUBLIC_PROJECT_ID=0268bdf2515ec528e27d6e1b8ee87e88

# USDT contract address on BSC
NEXT_PUBLIC_USDT_CONTRACT=0x1F71139BACbf9Ab15d239342f7783C69951736f7

# Company wallet address for receiving deposits
NEXT_PUBLIC_COMPANY_WALLET=0xB5D3abF4e34B921d4B1268bb5b6dA4C2437239B8

# BSC RPC URL for blockchain connections
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
